# TripWeave configuration TEMPLATE (placeholders only - never commit real values).
# Non-secret settings live in apps/api/wrangler.jsonc ("vars"). Secrets are set with
#   wrangler secret put <NAME> [--env staging|production]
# For local `wrangler dev`, copy apps/api/.dev.vars.example to apps/api/.dev.vars.

# --- web (apps/web, build/runtime) ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8787

# --- API secrets (wrangler secret put) ---
# Hotel supplier (first approved external provider: Hotelbeds). Needs credentials issued by Hotelbeds.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
# Amadeus Self-Service (free sign-up at developers.amadeus.com). Test keys only see a subset of hotels.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Routing (ROUTING_PROVIDER=google) - Google Routes API key restricted to the Routes API
GOOGLE_MAPS_API_KEY=
# Optional external LLM (only if Workers AI is not enough). OpenAI-compatible endpoint.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Email delivery (EMAIL_PROVIDER=resend) and sender
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
# Cloudflare Turnstile secret (verifies register/forgot-password); also expose the SITE key to the web app if you render the widget
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile SITE key, read by the web build; the widget shows only when this is set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Encrypts TOTP seeds at rest (32+ random chars). Without it two-step verification is unavailable.
MFA_ENCRYPTION_KEY=
